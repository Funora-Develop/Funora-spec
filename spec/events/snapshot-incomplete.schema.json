{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funora.dev/spec/0.1.0/events/snapshot-incomplete.schema.json",
  "x-funora-spec-version": "0.1.0",
  "x-funora-event-type": "snapshot.incomplete",
  "title": "SnapshotIncompleteEvent",
  "description": "Снимок собран не полностью. Сравнение по нему не порождает выводов об исчезновении: опорная точка сохраняется прежней.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "watch_id": {
      "x-funora-type": "entity_id"
    },
    "pages_fetched": {
      "type": "integer",
      "minimum": 0,
      "description": "Сколько страниц получено, штук."
    },
    "pages_requested": {
      "type": "integer",
      "minimum": 0,
      "description": "Сколько страниц запрошено, штук."
    },
    "reason_code": {
      "type": "string",
      "x-funora-plain": true,
      "description": "Машиночитаемая причина неполноты."
    }
  },
  "required": [
    "watch_id",
    "pages_fetched",
    "pages_requested",
    "reason_code"
  ]
}
