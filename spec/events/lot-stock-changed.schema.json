{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funora.dev/spec/0.1.0/events/lot-stock-changed.schema.json",
  "x-funora-spec-version": "0.1.0",
  "x-funora-event-type": "lot.stock_changed",
  "title": "LotStockChangedEvent",
  "description": "Остаток собственного лота изменился.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lot": {
      "$ref": "https://funora.dev/spec/0.1.0/models/lot.schema.json"
    },
    "before": {
      "type": "integer",
      "minimum": 0,
      "x-funora-observability": "unobserved-possible",
      "description": "Прежний остаток, штук. Отсутствие означает «не наблюдалось», а не ноль."
    },
    "after": {
      "type": "integer",
      "minimum": 0,
      "x-funora-observability": "unobserved-possible",
      "description": "Текущий остаток, штук. Отсутствие означает «не наблюдалось», а не ноль."
    }
  },
  "required": [
    "lot"
  ]
}
