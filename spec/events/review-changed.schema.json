{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funora.dev/spec/0.1.0/events/review-changed.schema.json",
  "x-funora-spec-version": "0.1.0",
  "x-funora-event-type": "review.changed",
  "title": "ReviewChangedEvent",
  "description": "Отзыв по заказу появился, изменился или удалён.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "x-funora-type": "entity_id"
    },
    "change": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "deleted"
      ],
      "x-funora-closed": true,
      "description": "Характер изменения."
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "x-funora-observability": "unobserved-possible",
      "description": "Оценка, баллов."
    }
  },
  "required": [
    "order_id",
    "change"
  ]
}
